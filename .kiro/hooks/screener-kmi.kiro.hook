{
  "enabled": true,
  "name": "KMI",
  "description": "Screen Kinder Morgan (KMI) as a dividend, growth, and value stock using the stock screener MCP with refresh enabled.",
  "version": "1",
  "when": {
    "type": "userTriggered"
  },
  "then": {
    "type": "askAgent",
    "prompt": "Run the stock_screener MCP tool with ticker=\"KMI\", stock_type=\"div,growth,value\", and refresh=true. Present the full results."
  }
}